{
    "name": "nadundesilva-website",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "NODE_ENV='development' NEXT_PUBLIC_WEBSITE_URL='http://localhost:3000' next dev --webpack -p 3000",
        "build": "NODE_ENV='production' next build --webpack && next-image-export-optimizer",
        "build:analyze": "ANALYZE='true' npm run build",
        "serve": "serve out",
        "start": "npm run build && npm run serve",
        "lint": "npm run lint:ts && npm run lint:css",
        "lint:ts": "eslint .",
        "lint:css": "stylelint \"**/*.css\"",
        "format:check": "prettier . --check",
        "format": "prettier . --write",
        "cypress:open": "cypress open",
        "cypress:e2e:run": "cypress run --e2e",
        "cypress:component:run": "cypress run --component",
        "cypress:typecheck": "tsc --noEmit -p cypress/tsconfig.json",
        "test:unit": "jest",
        "test:unit:coverage": "jest --coverage",
        "instrument": "nyc instrument --in-place --compact=false .",
        "prepare": "husky"
    },
    "browserslist": {
        "production": [
            "defaults and supports es6-module"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@icons-pack/react-simple-icons": "^13.15.1",
        "@sentry/nextjs": "^10.74.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "glob": "^13.0.6",
        "lucide-react": "^1.45.0",
        "motion": "^12.43.0",
        "next": "^16.3.5",
        "next-image-export-optimizer": "^1.21.1",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "reading-time": "^1.5.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@cypress/code-coverage": "4.0.3",
        "@cypress/webpack-batteries-included-preprocessor": "4.2.0",
        "@istanbuljs/nyc-config-typescript": "1.0.2",
        "@mdx-js/loader": "3.1.1",
        "@mdx-js/react": "3.1.1",
        "@next/bundle-analyzer": "16.3.5",
        "@next/mdx": "16.3.5",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/cypress": "10.1.3",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/cypress__code-coverage": "3.10.2",
        "@types/mdx": "2.0.14",
        "@types/node": "25.9.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/rss": "0.0.32",
        "browserslist": "4.28.9",
        "cypress": "15.21.1",
        "cypress-real-events": "^1.15.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.5",
        "eslint-config-prettier": "10.1.8",
        "husky": "9.1.7",
        "jest": "^30.5.1",
        "lint-staged": "17.5.1",
        "next-pwa": "5.6.0",
        "nyc": "18.0.0",
        "prettier": "3.9.6",
        "prettier-plugin-organize-imports": "4.3.0",
        "prettier-plugin-tailwindcss": "0.8.1",
        "rehype-pretty-code": "0.14.5",
        "rss": "1.2.2",
        "schema-dts": "2.0.0",
        "serve": "14.2.6",
        "shadcn": "4.21.0",
        "stylelint": "17.15.0",
        "stylelint-config-standard": "40.0.0",
        "stylelint-config-tailwindcss": "1.0.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3"
    },
    "lint-staged": {
        "*.{tsx,ts,js}": "eslint --no-cache --fix",
        "*.css": "stylelint --fix",
        "*.{tsx,ts,js,mdx}": "prettier --write"
    },
    "overrides": {
        "@cypress/webpack-batteries-included-preprocessor": {
            "@cypress/webpack-preprocessor": "7.1.2"
        }
    }
}
