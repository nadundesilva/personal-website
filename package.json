{
    "name": "nadundesilva-website",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "NODE_ENV='development' NEXT_PUBLIC_WEBSITE_URL='http://localhost:3000' next dev --webpack -p 3000",
        "build": "NODE_ENV='production' next build --webpack && next-image-export-optimizer",
        "build:analyze": "ANALYZE='true' npm run build",
        "start": "npm run build && npx serve@latest out",
        "lint": "npm run lint:ts && npm run lint:css",
        "lint:ts": "eslint .",
        "lint:css": "stylelint \"**/*.css\"",
        "format:check": "prettier . --check",
        "format": "prettier . --write",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run",
        "prepare": "husky"
    },
    "browserslist": {
        "production": [
            "defaults and supports es6-module"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "dependencies": {
        "@base-ui/react": "^1.4.0",
        "@icons-pack/react-simple-icons": "^13.13.0",
        "@sentry/nextjs": "^10.46.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "glob": "^13.0.6",
        "lucide-react": "^1.8.0",
        "motion": "^12.38.0",
        "next": "^16.2.1",
        "next-image-export-optimizer": "^1.20.1",
        "next-themes": "^0.4.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "reading-time": "^1.5.0",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2"
    },
    "devDependencies": {
        "@cypress/code-coverage": "4.0.3",
        "@istanbuljs/nyc-config-typescript": "1.0.2",
        "@mdx-js/loader": "3.1.1",
        "@mdx-js/react": "3.1.1",
        "@next/bundle-analyzer": "16.2.1",
        "@next/mdx": "16.2.1",
        "@tailwindcss/postcss": "^4.2.2",
        "@testing-library/cypress": "10.1.0",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/cypress__code-coverage": "3.10.2",
        "@types/mdx": "2.0.13",
        "@types/node": "25.5.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@types/rss": "0.0.32",
        "browserslist": "4.28.1",
        "cypress": "15.13.0",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.1",
        "eslint-config-prettier": "10.1.8",
        "husky": "9.1.7",
        "lint-staged": "17.0.2",
        "next-pwa": "5.6.0",
        "nyc": "18.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "rehype-pretty-code": "0.14.3",
        "rss": "1.2.2",
        "schema-dts": "2.0.0",
        "shadcn": "^4.3.0",
        "stylelint": "^17.9.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-tailwindcss": "^1.0.1",
        "tailwindcss": "^4.2.2",
        "typescript": "5.9.3"
    },
    "lint-staged": {
        "*.{tsx,ts,js}": "eslint --no-cache --fix",
        "*.css": "stylelint --fix",
        "*.{tsx,ts,js,mdx}": "prettier --write"
    }
}
